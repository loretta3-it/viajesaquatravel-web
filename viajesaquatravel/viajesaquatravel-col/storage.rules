rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAllowedFolder(folder) {
      return folder in ['media', 'destinations'];
    }

    function isAllowedContentType() {
      return request.resource != null
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp|avif)')
          || request.resource.contentType.matches('video/(mp4|webm)')
        );
    }

    match /{folder}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && isAllowedFolder(folder)
        && isAllowedContentType()
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin()
        && isAllowedFolder(folder);
    }
  }
}